---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content="Love Language" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!--
      Warm the connection to Komi the instant this page starts parsing, so the
      DNS lookup + TLS handshake to their origin (and CDN) finish in parallel
      with the rest of the page — the iframe below then loads with a hot
      connection instead of paying a cold round-trip. dns-prefetch is the
      fallback for browsers that ignore preconnect.
    -->
    <link rel="preconnect" href="https://lovelanguage.komi.io" crossorigin />
    <link rel="preconnect" href="https://cdn.komi.io" crossorigin />
    <link rel="dns-prefetch" href="https://lovelanguage.komi.io" />
    <link rel="dns-prefetch" href="https://cdn.komi.io" />
    <title>About — Love Language Music</title>
  </head>
  <body>
    <main class="viewport about">
      <div class="ambient" aria-hidden="true"></div>

      <section class="about-content">
        <h1 class="display-title">Love Language</h1>

        <!--
          Embedded Komi profile. Komi sends no X-Frame-Options / CSP
          frame-ancestors header, so it frames cleanly. Loaded eagerly with high
          fetch priority (paired with the preconnect above) so it starts booting
          the moment the page is reached, rather than waiting on the lazy-load
          heuristic — the embed is the whole point of this page.
        -->
        <iframe
          class="about-embed"
          src="https://lovelanguage.komi.io/"
          title="Love Language on Komi"
          loading="eager"
          fetchpriority="high"
          referrerpolicy="no-referrer-when-downgrade"
          allow="clipboard-write; encrypted-media; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </section>
    </main>
  </body>
</html>
